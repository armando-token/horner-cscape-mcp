[Options]
Trace=OFF
TraceTime=OFF
Simul=ON
Lock=IO
DEBUG=ON
CSCAPE=ON
CTSEG=OFF
NOCODESTAMP=ON
EMBEDSYMBOLS=ON
EMBEDSYBCASE=ON
NoCodeStamp = ON
FBDOPTIM=ON
LDOPTIM=ON
CHECKSYBCONFLICTS=ON
MAPBOOL=ON
MAPUSINT=ON
MAPUINT=ON
MAPUDINT=ON
MAPULINT=ON
MAPREAL=ON
MAPLREAL=ON
MAPTIME=ON
MAPSTRING=ON
MAPCOMPLEX=ON


[SimulCode]
Target=T5SIMUL
Suffix=.XWS
MotorolaEndian=FALSE
T5Style=ON

[TargetCode]
Target=T5RTI
Suffix=.XTI
MotorolaEndian=FALSE
T5Style=ON
Comment=Straton T5 runtime (Intel like byte ordering)
ConfigName=T5RTI
