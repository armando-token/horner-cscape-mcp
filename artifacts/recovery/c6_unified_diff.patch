+def ensure_desktop():
+    try:
+        hd = user32.OpenDesktopW("Default", 0, False, 0x01FF)
+        if hd:
+            user32.SetThreadDesktop(hd)
+            return hd
+    except Exception as e:
+        log(f"Warning attaching to desktop: {e}")
+    return None
+
