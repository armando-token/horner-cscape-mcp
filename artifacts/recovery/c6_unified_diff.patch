+def execute_c6_pipeline():
+    ensure_desktop()
+    log("=" * 80)
+    log("STARTING MISSION C6_AUTOMATE_NATIVE_PATH PIPELINE EXECUTION")
+    log("=" * 80)
+
+    # 1. Baseline Isolation Check (Before)
