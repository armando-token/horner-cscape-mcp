+                "warning_count": 0,
+                "errors": [err_msg],
+                "warnings": [],
+                "build_log": err_msg,
+                "diagnostics": [{
+                    "level": "ERROR",
+                    "message": err_msg,
+                    "file_path": "",
+                    "line": 1,
+                    "column": 1,
+                    "error_code": "INVALID_TIMEOUT_VALUE",
+                }],
+                "memory_footprint": {
+                    "code_size_bytes": 0,
+                    "data_size_bytes": 0,
+                    "retain_size_bytes": 0,
+                    "total_size_bytes": 0,
+                    "ast_statement_count": 0,
+                    "ast_variable_count": 0,
+                    "ast_expression_count": 0,
+                    "source_bytes_total": 0,
+                },
+                "hardware_lockout_enforced": True,
+                "message": err_msg,
+                "compiled_at": _get_utc_timestamp(),
+            }
+
+        if project_path is not None and not str(project_path).strip():
+            err_msg = "Project path cannot be empty or whitespace-only"
+            return {
+                "success": False,
+                "status": "failed",
+                "error_code": "INVALID_PROJECT_PATH",
+                "project_name": "Unknown",
+                "build_time_seconds": 0.0,
+                "error_count": 1,
+                "warning_count": 0,
+                "errors": [err_msg],
+                "warnings": [],
+                "build_log": err_msg,
+                "diagnostics": [{
+                    "level": "ERROR",
+                    "message": err_msg,
+                    "file_path": "",
+                    "line": 1,
+                    "column": 1,
+                    "error_code": "INVALID_PROJECT_PATH",
+                }],
+                "memory_footprint": {
+                    "code_size_bytes": 0,
+                    "data_size_bytes": 0,
