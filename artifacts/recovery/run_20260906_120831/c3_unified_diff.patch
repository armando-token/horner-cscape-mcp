+                status=BuildStatus.FAILED,
+                project_name=project_name,
+                project_path=str(p_path),
+                build_time_seconds=duration,
+                error_count=1,
+                warning_count=0,
+                diagnostics=[diag],
+                raw_log=f"=== Horner Cscape 10.2 Compile Pass: {project_name} ===\nError: {err_msg}\nBuild Result: FAILED",
+                memory_footprint={
+                    "code_size_bytes": 0,
+                    "data_size_bytes": 0,
