+
+    # =========================================================================
+    # Step 4: Automated Lifecycle - EDIT (In-GUI Interaction)
+    # =========================================================================
+    log("Automating Lifecycle Step 4: EDIT (In-GUI Interaction)...")
+    user32.SendMessageW(live_hwnd, WM_COMMAND, ID_PROGRAM_VARIABLES, 0)
