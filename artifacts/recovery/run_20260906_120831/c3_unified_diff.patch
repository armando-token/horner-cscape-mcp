+
+        # 3. If cscape_hwnd is provided, trigger live GUI compile via ID_PROGRAM_ERRORCHECK
+        if cscape_hwnd is not None:
+            gui_res = compiler.trigger_cscape_gui_compile(
+                cscape_hwnd=cscape_hwnd,
+                timeout_sec=timeout_seconds,
