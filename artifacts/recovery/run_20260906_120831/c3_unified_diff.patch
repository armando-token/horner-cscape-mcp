+
+        diagnostics = self.parse_build_output(output_text)
+        errors_list = [d.message for d in diagnostics if d.level == "ERROR"]
+        warnings_list = [d.message for d in diagnostics if d.level == "WARNING"]
+        error_count = len(errors_list)
