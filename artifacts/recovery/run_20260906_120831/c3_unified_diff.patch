+OCS_WORD_REGISTERS: frozenset[str] = frozenset({
+    "%R", "%AI", "%AQ", "%SR", "%AIG", "%AQG",
+    "%IW", "%QW", "%MW",
+})
+
+OCS_BIT_REGISTERS: frozenset[str] = frozenset({
+    "%M", "%T", "%I", "%Q", "%D", "%K", "%S", "%IG", "%QG",
+    "%IX", "%QX", "%MX",
+})
