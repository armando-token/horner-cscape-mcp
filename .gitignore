# ==============================================================================
# Horner Cscape MCP - Production-Grade Git Ignore Specification
# Conforms to GitHub Best Practices & Horner OCS / IEC 61131-3 Pipeline Safety
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python Artifacts & Distribution Packaging
# ------------------------------------------------------------------------------
__pycache__/
__pycache__
*.py[cod]
*$py.class
*.so
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
Downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 2. Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. Testing & Code Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
.pytest_temp/
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# ------------------------------------------------------------------------------
# 4. Cscape, PLC & CFBF (Compound File Binary Format) Artifacts
# ------------------------------------------------------------------------------
# Editor backup, temporary & lock files
*.bak
*.tmp
~*
\#*
\#*#
*.lock
*.lck
.~lock.*

# CFBF streams & Cscape runtime caches
~$*.csp
~$*.cpj
*.csp.tmp
*.cpj.tmp
*.cfbf.tmp
*.stream.tmp
*.cpo
*.t5r
*.lge
*.compiled
*.k5p.bak
Cscape*.tmp

# Preserve tracked golden fixtures/backups in repository
!artifacts/projects/TankLevelClosedLoop/*.bak*

# ------------------------------------------------------------------------------
# 5. OS & IDE / Editor Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/

# JetBrains / VS Code / Sublime / Vim / Eclipse
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.sublime-*
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ------------------------------------------------------------------------------
# 6. Sensitive Files, Credentials & Certificates
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
*.id_rsa
*.id_rsa.pub
id_rsa
id_rsa.pub
*.id_ed25519
*.id_ed25519.pub
id_ed25519
id_ed25519.pub
secrets.json
secrets.yaml
credentials.json
credentials.yaml

# ------------------------------------------------------------------------------
# 7. State & Local Caches, Dumps & Diagnostics
# ------------------------------------------------------------------------------
.state/
!/.state/*.json
scratch/
scratch_verifier_clean.py
scratch_verifier_raw.txt
foo/

# Crash dumps & runtime trace logs
*.dmp
*.dump
*.stackdump
crash_dump*
@AutomationLog.txt

# ------------------------------------------------------------------------------
# 8. Large Distribution Bundles & Archives (Publish via GitHub Releases)
# ------------------------------------------------------------------------------
*.zip
*.tar.gz
*.tgz
*.7z
*.rar
TankLevelClosedLoop_OFFLINE_HANDOFF.zip
TankLevel_P5_Dedicated_offline_bundle_*.zip
offline_evidence_bundle_*.zip
horner-cscape-*-bundle.zip
horner-cscape-project-handoff-*.zip
