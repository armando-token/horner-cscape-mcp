+
+        if project_path is not None and target.is_file():
+            err_msg = f"Project path is not a directory: {target}"
+            return {
+                "success": False,
+                "status": "failed",
+                "error_code": "INVALID_PROJECT_PATH",
+                "project_name": target.name,
+                "build_time_seconds": 0.0,
+                "error_count": 1,
+                "warning_count": 0,
+                "errors": [err_msg],
